function buildClassRowsWithSummary_(classes) {
  const result = [];

  const groups = {
    "อนุบาล": {},
    "ประถม": {},
    "มัธยม": {}
  };

  classes.forEach(cls => {
    const group = getClassGroup_(cls.grade);
    const level = extractLevelNumber_(cls.grade);

    if (!groups[group][level]) {
      groups[group][level] = [];
    }

    groups[group][level].push(cls);
  });

  const groupOrder = ["อนุบาล", "ประถม", "มัธยม"];

  groupOrder.forEach(group => {
    let groupMale = 0;
    let groupFemale = 0;
    let groupTotal = 0;

    const levels = Object.keys(groups[group])
      .map(Number)
      .sort((a, b) => a - b);

    levels.forEach(level => {
      const rows = groups[group][level];

      let levelMale = 0;
      let levelFemale = 0;
      let levelTotal = 0;

      rows.forEach(row => {
        result.push(row);

        levelMale += row.male;
        levelFemale += row.female;
        levelTotal += row.male + row.female;
      });

      result.push(createSummaryRow_(
        `รวม${group} ${level}`,
        levelMale,
        levelFemale,
        levelTotal
      ));

      groupMale += levelMale;
      groupFemale += levelFemale;
      groupTotal += levelTotal;
    });

    if (levels.length > 0) {
      result.push(createSummaryRow_(
        `รวม${group}`,
        groupMale,
        groupFemale,
        groupTotal
      ));
    }
  });

  const grandMale = result
    .filter(row => !row.isSummary)
    .reduce((sum, row) => sum + row.male, 0);

  const grandFemale = result
    .filter(row => !row.isSummary)
    .reduce((sum, row) => sum + row.female, 0);

  const grandTotal = grandMale + grandFemale;

  result.push(createSummaryRow_(
    "รวมนักเรียนทั้งหมด",
    grandMale,
    grandFemale,
    grandTotal
  ));

  return result;
}

function createSummaryRow_(grade, male, female, total) {
  return {
    row: "",
    grade,
    male,
    female,
    total,
    teacher: "",
    isSummary: true
  };
}

function getClassGroup_(grade) {
  grade = String(grade || "");

  if (grade.includes("อนุบาล")) return "อนุบาล";
  if (grade.includes("ประถม")) return "ประถม";
  if (grade.includes("มัธยม")) return "มัธยม";

  return "อื่น ๆ";
}

function getClassSortKey_(grade) {
  grade = String(grade || "").trim();

  if (grade === "รวมนักเรียนทั้งหมด" || grade === "รวมทั้งหมด") {
    return 999999;
  }

  // ===== แถวรวมรายระดับชั้นแบบชื่อเต็ม =====
  if (grade.startsWith("รวมระดับชั้นอนุบาลศึกษาปีที่")) {
    const level = extractLevelNumber_(grade);
    return 10000 + (level * 100) + 99;
  }

  if (grade === "รวมระดับชั้นอนุบาลศึกษา") {
    return 19999;
  }

  if (grade.startsWith("รวมระดับชั้นประถมศึกษาปีที่")) {
    const level = extractLevelNumber_(grade);
    return 20000 + (level * 100) + 99;
  }

  if (grade === "รวมระดับชั้นประถมศึกษา") {
    return 29999;
  }

  if (grade.startsWith("รวมระดับชั้นมัธยมศึกษาปีที่")) {
    const level = extractLevelNumber_(grade);
    return 30000 + (level * 100) + 99;
  }

  if (grade === "รวมระดับชั้นมัธยมศึกษา") {
    return 39999;
  }

  // ===== ห้องเรียนจริง =====
  const level = extractLevelNumber_(grade);
  const room = extractRoomNumber_(grade);

  if (grade.includes("อนุบาล")) {
    return 10000 + (level * 100) + room;
  }

  if (grade.includes("ประถม")) {
    return 20000 + (level * 100) + room;
  }

  if (grade.includes("มัธยม")) {
    return 30000 + (level * 100) + room;
  }

  return 99999;
}


function extractLevelNumber_(text) {
  const match = String(text).match(/ปีที่\s*(\d+)/);
  return match ? Number(match[1]) : 0;
}

function extractRoomNumber_(text) {
  const match = String(text).match(/\/\s*(\d+)/);
  return match ? Number(match[1]) : 0;
}

function extractNumber_(text) {
  const match = String(text).match(/\d+/);
  return match ? Number(match[0]) : 0;
}

