  const totalStudent = maleTotal + femaleTotal;

  const maleCome = Number(data.maleCome) || 0;
  const femaleCome = Number(data.femaleCome) || 0;
  const totalCome = maleCome + femaleCome;

  if (maleCome > maleTotal) {
    return {
      success: false,
      message: "ชายมา ต้องไม่มากกว่าชายทั้งหมด"
    };
