function getClassListForCheck() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(SHEET_STATS);

  if (!sheet) {
    throw new Error("ไม่พบชีตสถิตินักเรียนทั้งหมด");
  }

  const data = sheet.getDataRange().getValues();
  const result = [];

  for (let i = 1; i < data.length; i++) {
    const grade = String(data[i][0]).trim();

    if (!grade || grade.startsWith("รวม")) {
      continue;
    }

    result.push({
      grade: grade,
      teacher: data[i][4] || ""
    });
  }

  return result;
