function rptGetClassList(sheet) {
  const result = [];

  if (!sheet) return result;

  const lastRow = sheet.getLastRow();

  if (lastRow < STATS_DATA_START_ROW) return result;

  const numRows = lastRow - STATS_HEADER_ROWS;

  const data = sheet
    .getRange(STATS_DATA_START_ROW, 1, numRows, 5)
    .getValues();

  data.forEach(row => {
    const grade = String(row[0] || "").trim();
    const male = Number(row[1]) || 0;
    const female = Number(row[2]) || 0;

    if (!grade || grade.startsWith("รวม")) return;

    result.push({
      grade,
      male,
      female,
      total: male + female,
      teacher: row[4] || "",
      sortKey: getClassSortKey_(grade)
    });
  });

  return result.sort((a, b) => a.sortKey - b.sortKey);
}

function rptGetAttendanceMap(sheet, dateKey) {
  const map = {};

  if (!sheet || sheet.getLastRow() < 2) return map;

  const data = sheet.getRange(2, 1, sheet.getLastRow() - 1, 8).getValues();

  data.forEach(row => {
    const rowDate = row[0];
    const grade = String(row[1] || "").trim();

    if (!rowDate || !grade) return;

    const rowDateObj = parseAnyDate(rowDate);
    const rowDateKey = formatDateKey(rowDateObj);

    if (rowDateKey === dateKey) {
      map[grade] = {
        totalMale: Number(row[2]) || 0,
        totalFemale: Number(row[3]) || 0,
        totalStudent: Number(row[4]) || 0,
        male: Number(row[5]) || 0,
