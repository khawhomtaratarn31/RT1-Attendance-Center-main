function getAttendanceHistoryForCheck(options) {
  const grade = options.grade;
  const mode = options.mode;
  const month = options.month;

  if (!grade) return [];

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName(SHEET_ATTENDANCE);

  if (!sh || sh.getLastRow() < 2) return [];

  // โครงชีตบันทึกการมาเรียน:
  // A วันที่ | B ระดับชั้น | C ชายทั้งหมด | D หญิงทั้งหมด | E รวมทั้งหมด | F ชายมา | G หญิงมา | H รวมมา
  const data = sh.getRange(2, 1, sh.getLastRow() - 1, 8).getValues();
  const range = getCheckDateRange_(mode, month);

  return data
    .map((row, index) => ({
      rowNumber: index + 2,
      row: row
    }))
    .filter(item => {
      const row = item.row;
      const rowDate = normalizeDate_(row[0]);
      const rowGrade = String(row[1] || "").trim();

      return rowGrade === grade &&
             rowDate >= range.start &&
             rowDate <= range.end;
    })
    .sort((a, b) => normalizeDate_(a.row[0]) > normalizeDate_(b.row[0]) ? 1 : -1)
    .map(item => {
      const row = item.row;

      return {
        recordId: item.rowNumber,
        dateText: formatDateThai_(row[0]),
        grade: row[1],
        maleTotal: Number(row[2]) || 0,
        femaleTotal: Number(row[3]) || 0,
        totalStudent: Number(row[4]) || 0,
        maleCome: Number(row[5]) || 0,
        femaleCome: Number(row[6]) || 0,
        totalCome: Number(row[7]) || 0
      };
    });
}

function findHeaderIndex(headers, names) {
  for (let i = 0; i < names.length; i++) {
    const index = headers.indexOf(names[i]);
    if (index !== -1) return index;
  }
  return -1;
}

function normalizeDate_(value) {
  if (value instanceof Date) {
    return Utilities.formatDate(value, Session.getScriptTimeZone(), "yyyy-MM-dd");
  }

  return String(value).slice(0, 10);
}

function formatDateThai_(value) {
  if (!value) return "";

  const date = value instanceof Date ? value : new Date(value);

  if (isNaN(date.getTime())) {
    return String(value);
  }

  return Utilities.formatDate(date, Session.getScriptTimeZone(), "dd/MM/yyyy");
}

function getCheckDateRange_(mode, month) {
  if (mode === "month") {
    if (!month) {
      throw new Error("กรุณาเลือกเดือน");
    }

    const start = month + "-01";
    const parts = month.split("-");
    const year = Number(parts[0]);
    const m = Number(parts[1]);

    const lastDate = new Date(year, m, 0);
    const end = Utilities.formatDate(
      lastDate,
      TIMEZONE,
      "yyyy-MM-dd"
    );

    return {
      start: start,
      end: end
    };
  }

  const term = getActiveTerm();

  if (!term) {
    throw new Error("ยังไม่ได้ตั้งค่าภาคเรียนที่มีสถานะใช้งาน");
  }

  return {
    start: formatDateKey(term.startDate),
    end: formatDateKey(term.endDate || getTodayOnly())
  };
}


