function loginAdmin(username, password) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName(SHEET_USERS);

  if (!sh) {
    return {
      success: false,
      message: "ไม่พบชีตผู้ใช้งานระบบ"
    };
  }

  const values = sh.getDataRange().getValues();

  for (let i = 1; i < values.length; i++) {
    const user = String(values[i][0] || "").trim();
    const pass = String(values[i][1] || "").trim();
    const role = String(values[i][2] || "").trim();
    const status = String(values[i][3] || "").trim();

    if (
      user === username &&
      pass === password &&
      role === "admin" &&
      status === "ใช้งาน"
    ) {
      return {
        success: true,
        message: "เข้าสู่ระบบสำเร็จ",
        user: user,
        role: role
      };
    }
  }

  return {
    success: false,
    message: "ชื่อผู้ใช้หรือรหัสผ่านไม่ถูกต้อง"
  };
}


// =========================
// บันทึกข้อมูลจาก index
// =========================
function submitAttendanceData(

  date,
  grade,
  totalMale,
  totalFemale,
  maleAttend,
  femaleAttend

) {

  const ss = SpreadsheetApp.getActiveSpreadsheet();

  const sheetStats =
    ss.getSheetByName(SHEET_STATS);

  const sheetAttendance =
    ss.getSheetByName(SHEET_ATTENDANCE);


  if (!sheetStats || !sheetAttendance) {

    throw new Error(
      "ไม่พบชีต สถิตินักเรียนทั้งหมด หรือ บันทึกการมาเรียน"
    );

  }


  totalMale =
    Number(totalMale) || 0;

  totalFemale =
    Number(totalFemale) || 0;

  maleAttend =
    Number(maleAttend) || 0;

  femaleAttend =
    Number(femaleAttend) || 0;


  const totalStudent =
    totalMale + totalFemale;

  const totalAttend =
    maleAttend + femaleAttend;


  const dateObj =
    parseDateFromIndex(date);

  const dateKey =
    formatDateKey(dateObj);


  // validate
  if (!date || !grade) {

    throw new Error(
      "กรุณากรอกวันที่และระดับชั้น"
    );

  }


  if (maleAttend > totalMale) {

    throw new Error(
      "จำนวนชายมาเรียนมากกว่าจำนวนชายทั้งหมด"
    );

  }


  if (femaleAttend > totalFemale) {

    throw new Error(
      "จำนวนหญิงมาเรียนมากกว่าจำนวนหญิงทั้งหมด"
    );

  }


  // อัปเดตสถิตินักเรียนทั้งหมด
  upsertStudentStats(

    sheetStats,
    grade,
    totalMale,
    totalFemale,
    totalStudent

  );


  // บันทึกการมาเรียน
  upsertAttendance(
    sheetAttendance,
    dateObj,
    dateKey,
    grade,
    totalMale,
    totalFemale,
    totalStudent,
    maleAttend,
    femaleAttend,
    totalAttend
  );


  return "บันทึกข้อมูลเรียบร้อยแล้ว";

}



// =========================
// อัปเดตชีต สถิตินักเรียนทั้งหมด
// =========================
function upsertStudentStats(

  sheet,
  grade,
  totalMale,
  totalFemale,
  totalStudent

) {

  const lastRow =
    sheet.getLastRow();

  const data =
    sheet.getRange(2, 1, lastRow - 1, 5)
      .getValues();


  for (let i = 0; i < data.length; i++) {

    const className =
      String(data[i][0]).trim();


    // ข้ามแถวรวม
    if (
      !className ||
      className.startsWith("รวม")
    ) {

      continue;

    }


    // เจอห้อง
    if (className === grade) {

      const row = i + 2;

      // B = ชาย
      sheet.getRange(row, 2)
        .setValue(totalMale);

      // C = หญิง
      sheet.getRange(row, 3)
        .setValue(totalFemale);

      // D = รวม
      sheet.getRange(row, 4)
        .setValue(totalStudent);

      return;

    }

  }


  throw new Error(
    `ไม่พบระดับชั้น "${grade}" ในชีตสถิตินักเรียนทั้งหมด`
  );

}



// =========================
// บันทึกชีต การมาเรียน
// =========================
function upsertAttendance(
  sheet,
  dateObj,
  dateKey,
  grade,
  totalMale,
  totalFemale,
  totalStudent,
  maleAttend,
  femaleAttend,
  totalAttend
) {
  const lastRow = sheet.getLastRow();

  if (lastRow > 1) {
    const data = sheet.getRange(2, 1, lastRow - 1, 8).getValues();

    for (let i = data.length - 1; i >= 0; i--) {
      const rowDate = data[i][0];
      const rowGrade = data[i][1];
      const rowDateKey = formatDateKey(parseAnyDate(rowDate));

      if (rowDateKey === dateKey && rowGrade === grade) {
        sheet.deleteRow(i + 2);
      }
    }
  }

  sheet.appendRow([
    dateObj,
    grade,
    totalMale,
    totalFemale,
    totalStudent,
    maleAttend,
    femaleAttend,
    totalAttend
  ]);
}



// =========================
// parse วันที่จาก index
// yyyy-mm-dd
// =========================
function parseDateFromIndex(dateString) {

  const parts =
    String(dateString).split("-");


  return new Date(

    Number(parts[0]),
    Number(parts[1]) - 1,
    Number(parts[2])

  );

}



// =========================
// parse วันที่ทั่วไป
// =========================
function parseAnyDate(value) {

  if (value instanceof Date) {

    return new Date(

      value.getFullYear(),
      value.getMonth(),
      value.getDate()

    );

  }


  if (typeof value === "string") {

    const text =
      value.trim();


    // yyyy-mm-dd
    if (text.includes("-")) {

      const parts =
        text.split("-");


      if (parts[0].length === 4) {

        return new Date(

          Number(parts[0]),
          Number(parts[1]) - 1,
          Number(parts[2])

        );

      }

    }


    // dd/mm/yyyy
    if (text.includes("/")) {

      const parts =
        text.split("/");


      let year =
        Number(parts[2]);


      // พ.ศ.
      if (year > 2400) {

        year -= 543;

      }


      return new Date(

        year,
        Number(parts[1]) - 1,
        Number(parts[0])

      );

    }

  }


  return new Date(value);

}



// =========================
// format วันที่
// =========================
function formatDateKey(dateObj) {

  return Utilities.formatDate(

    dateObj,
    TIMEZONE,
    "yyyy-MM-dd"

  );

}





