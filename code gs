function normalizeStudentStatsSheet_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName(SHEET_STATS);

  const lastRow = sh.getLastRow();

  if (lastRow < STATS_DATA_START_ROW) return;

  const numRows = lastRow - STATS_HEADER_ROWS;

  const data = sh.getRange(STATS_DATA_START_ROW, 1, numRows, 5).getValues();

  const classes = data
    .map(row => {
      const grade = String(row[0] || "").trim();
      const male = Number(row[1]) || 0;
      const female = Number(row[2]) || 0;

      return {
        grade,
        male,
        female,
        total: male + female,
        teacher: row[4] || "",
        sortKey: getClassSortKey_(grade)
      };
    })
    .filter(item => item.grade && !item.grade.startsWith("รวม"))
    .sort((a, b) => a.sortKey - b.sortKey);

  const rows = buildClassRowsForSheet_(classes);

  sh.getRange(STATS_DATA_START_ROW, 1, numRows, 5).clearContent();

  if (rows.length > 0) {
    sh.getRange(STATS_DATA_START_ROW, 1, rows.length, 5).setValues(rows);
  }
}

function buildClassRowsForSheet_(classes) {
  const result = [];

  const groups = {
    "อนุบาล": {},
    "ประถม": {},
    "มัธยม": {}
  };

  classes.forEach(cls => {
    const group = getClassGroup_(cls.grade);
    const level = extractLevelNumber_(cls.grade);

    if (!groups[group][level]) groups[group][level] = [];
    groups[group][level].push(cls);
  });

  ["อนุบาล", "ประถม", "มัธยม"].forEach(group => {
    let groupMale = 0;
    let groupFemale = 0;
    let groupTotal = 0;

    const levels = Object.keys(groups[group]).map(Number).sort((a, b) => a - b);

    levels.forEach(level => {
      let levelMale = 0;
      let levelFemale = 0;
      let levelTotal = 0;

      groups[group][level].forEach(cls => {
        result.push([
          cls.grade,
          cls.male,
          cls.female,
          cls.male + cls.female,
          cls.teacher
        ]);

        levelMale += cls.male;
        levelFemale += cls.female;
        levelTotal += cls.male + cls.female;
      });

      result.push([
        getLevelSummaryName_(group, level),
        levelMale,
        levelFemale,
        levelTotal,
        ""
      ]);

      groupMale += levelMale;
      groupFemale += levelFemale;
      groupTotal += levelTotal;
    });

    if (levels.length > 0) {
      result.push([
      getGroupSummaryName_(group),
      groupMale,
      groupFemale,
      groupTotal,
      ""
    ]);
    }
  });

  const grandMale = classes.reduce((sum, row) => sum + row.male, 0);
  const grandFemale = classes.reduce((sum, row) => sum + row.female, 0);

  result.push([
    "รวมนักเรียนทั้งหมด",
    grandMale,
    grandFemale,
    grandMale + grandFemale,
    ""
  ]);
  return result;
}

function getLevelSummaryName_(group, level) {
  if (group === "อนุบาล") {
    return `รวมระดับชั้นอนุบาลศึกษาปีที่ ${level}`;
  }

  if (group === "ประถม") {
    return `รวมระดับชั้นประถมศึกษาปีที่ ${level}`;
  }

  if (group === "มัธยม") {
    return `รวมระดับชั้นมัธยมศึกษาปีที่ ${level}`;
  }

  return `รวมระดับชั้น ${level}`;
}

function getGroupSummaryName_(group) {
  if (group === "อนุบาล") {
    return "รวมระดับชั้นอนุบาลศึกษา";
  }

  if (group === "ประถม") {
    return "รวมระดับชั้นประถมศึกษา";
  }

  if (group === "มัธยม") {
    return "รวมระดับชั้นมัธยมศึกษา";
  }

  return `รวมระดับ${group}`;
}

//-------------ฟังก์ชันสร้างชีตบันทึกครูเวรประจำวัน
function ensureDutyLogSheet_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sh = ss.getSheetByName(SHEET_DUTY_LOG);

  if (!sh) {
    sh = ss.insertSheet(SHEET_DUTY_LOG);
  }

  sh.getRange(1, 1, 1, 6).setValues([[
    "Timestamp",
    "วันที่",
    "บันทึกครูเวร",
    "เพิ่มเติม",
    "ชื่อครูเวร",
    "PDF URL"
  ]]);

  return sh;
}

//--------ฟังก์ชันบันทึกครูเวร
function saveDutyLog(data) {
  const sh = ensureDutyLogSheet_();

  const dateObj = data.date ? parseAnyDate(data.date) : null;
  const dateKey = dateObj ? formatDateKey(dateObj) : "";

  const dutyNote = String(data.dutyNote || "").trim();
  const extraNote = String(data.extraNote || "").trim();
  const teacherName = String(data.teacherName || "").trim();

  if (!dateKey || !dutyNote || !teacherName) {
    throw new Error("กรุณากรอกวันที่ เลือกบันทึกครูเวร และกรอกชื่อครูเวร");
  }

  const lastRow = sh.getLastRow();

  if (lastRow > 1) {
    const values = sh.getRange(2, 1, lastRow - 1, 6).getValues();

    for (let i = values.length - 1; i >= 0; i--) {
      const rowDateKey = formatDateKey(parseAnyDate(values[i][1]));

      if (rowDateKey === dateKey) {
        sh.deleteRow(i + 2);
      }
    }
  }

  sh.appendRow([
    new Date(),
    dateObj,
    dutyNote,
    extraNote,
    teacherName,
    ""
  ]);

  return {
    success: true,
    message: "บันทึกครูเวรประจำวันเรียบร้อยแล้ว"
  };
}

//------------ฟังก์ชันดึงข้อมูลครูเวรตามวันที่
function getDutyLogByDate_(dateObj) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName(SHEET_DUTY_LOG);

  if (!sh || sh.getLastRow() < 2) {
    return null;
  }

  const targetKey = formatDateKey(dateObj);
  const values = sh.getRange(2, 1, sh.getLastRow() - 1, 6).getValues();

  for (let i = values.length - 1; i >= 0; i--) {
    const rowDate = values[i][1];
    const rowKey = formatDateKey(parseAnyDate(rowDate));

    if (rowKey === targetKey) {
      return {
        row: i + 2,
        dutyNote: values[i][2] || "",
        extraNote: values[i][3] || "",
        teacherName: values[i][4] || "",
        pdfUrl: values[i][5] || ""
      };
    }
  }

  return null;
}


//--------------ฟังก์ชันสร้าง PDF จาก Google Slides
function generateDutyReportPDF(dateStr) {
  const dateObj = parseAnyDate(dateStr);
  const dateKey = formatDateKey(dateObj);

  const duty = getDutyLogByDate_(dateObj);

  if (!duty) {
    throw new Error("ไม่พบบันทึกครูเวรของวันที่เลือก");
  }

  const school = getSchoolSettings();

  const schoolName = school.schoolName || "โรงเรียน";
  const directorName = school.director || "";
  const thaiDate = rptThaiDateFull(dateObj);

  const dutyText = buildDutyText_(duty.dutyNote, duty.extraNote);

  const folder = DriveApp.getFolderById(DUTY_PDF_FOLDER_ID);

  const copyFile = DriveApp
    .getFileById(DUTY_TEMPLATE_SLIDE_ID)
    .makeCopy(`บันทึกครูเวร_${dateKey}`, folder);

  const presentation = SlidesApp.openById(copyFile.getId());

  presentation.replaceAllText("{{DATE}}", thaiDate);
  presentation.replaceAllText("{{DUTY_TEXT}}", dutyText);
  presentation.replaceAllText("{{TEACHER_NAME}}", duty.teacherName || "");
  presentation.replaceAllText("{{DIRECTOR_NAME}}", directorName || "");
  presentation.replaceAllText("{{SCHOOL_NAME}}", schoolName || "");

  presentation.saveAndClose();

  const pdfBlob = DriveApp
    .getFileById(copyFile.getId())
    .getBlob()
    .getAs(MimeType.PDF)
    .setName(`บันทึกครูเวร_${dateKey}.pdf`);

  const pdfFile = folder.createFile(pdfBlob);

  try {
    pdfFile.setSharing(
      DriveApp.Access.ANYONE_WITH_LINK,
      DriveApp.Permission.VIEW
    );
  } catch (err) {
    Logger.log("ไม่สามารถตั้งค่าแชร์ PDF ครูเวรได้: " + err.message);
  }

  copyFile.setTrashed(true);

  const sh = ensureDutyLogSheet_();
  sh.getRange(duty.row, 6).setValue(pdfFile.getUrl());

  return {
    dateText: thaiDate,
    url: pdfFile.getUrl()
  };
}

function buildDutyText_(dutyNote, extraNote) {
  dutyNote = String(dutyNote || "").trim();
  extraNote = String(extraNote || "").trim();

  if (extraNote) {
    return dutyNote + "\n\nเพิ่มเติม: " + extraNote;
  }

  return dutyNote;
}



//----------ค้นหาประวัติบันทึกครูเวร
function getDutyHistory(dateStr) {

  const sh =
    SpreadsheetApp.getActiveSpreadsheet()
      .getSheetByName(SHEET_DUTY_LOG);

  if (!sh || sh.getLastRow() < 2) {
    return [];
  }

  const values =
    sh.getRange(
      2,
      1,
      sh.getLastRow() - 1,
      6
    ).getValues();

  let rows = values.map((r, index) => ({

    row: index + 2,

    timestamp: r[0],

    date: Utilities.formatDate(
      new Date(r[1]),
      Session.getScriptTimeZone(),
      "yyyy-MM-dd"
    ),

    dutyNote: r[2] || "",

    extraNote: r[3] || "",

    teacherName: r[4] || "",

    pdfUrl: r[5] || ""

  }));

  if (dateStr) {

    rows = rows.filter(
      r => r.date === dateStr
    );

  }

  rows.sort((a,b)=>
    new Date(b.date) - new Date(a.date)
  );

  return rows;
}

function updateDutyLog(data) {

  const sh = ensureDutyLogSheet_();

  const row = Number(data.row);

  if (!row || row < 2) {
    return {
      success: false,
      message: "ไม่พบแถวที่ต้องการแก้ไข"
    };
  }

  const dateObj = parseAnyDate(data.date);

  sh.getRange(row, 2).setValue(dateObj);
  sh.getRange(row, 3).setValue(data.dutyNote || "");
  sh.getRange(row, 4).setValue(data.extraNote || "");
  sh.getRange(row, 5).setValue(data.teacherName || "");

  return {
    success: true,
    message: "แก้ไขข้อมูลเรียบร้อยแล้ว"
  };

}


function deleteDutyLog(row) {

  const sh = ensureDutyLogSheet_();

  row = Number(row);

  if (!row || row < 2) {
    return {
      success: false,
      message: "ไม่พบข้อมูลที่ต้องการลบ"
    };
  }

  const pdfUrl = sh.getRange(row, 6).getValue();

  try {

    if (pdfUrl) {

      const fileId =
        extractDriveFileId_(pdfUrl);

      DriveApp
        .getFileById(fileId)
        .setTrashed(true);

    }

  } catch(err) {
    Logger.log(err);
  }

  sh.deleteRow(row);

  return {
    success: true,
    message: "ลบข้อมูลเรียบร้อยแล้ว"
  };

}