  const sheetAttendance = ss.getSheetByName(SHEET_ATTENDANCE);

  let sheetDaily = ss.getSheetByName("สรุปการมาเรียนรายวัน");
  if (!sheetDaily) {
    sheetDaily = ss.insertSheet("สรุปการมาเรียนรายวัน");
  }

  const schoolSettings = getSchoolSettings();
  const activeTerm = getActiveTermInfo();

  const schoolName = schoolSettings.schoolName || "โรงเรียน";
  const academicYear = schoolSettings.academicYear || "";
  const logoFileId = schoolSettings.logoFileId || "";
  const termText = activeTerm && activeTerm.term
    ? `ภาคเรียนที่ ${activeTerm.term}`
    : "";

  const dateKey = formatDateKey(dateObj);
  const thaiDate = rptThaiDateFull(dateObj);

  const classes = rptGetClassList(sheetStats);
  const attendanceMap = rptGetAttendanceMap(sheetAttendance, dateKey);

  const detailRows = classes.map(cls => {
    const attend = attendanceMap[cls.grade] || {
      totalMale: cls.male,
      totalFemale: cls.female,
      totalStudent: cls.total,
      male: 0,
      female: 0,
      total: 0
    };

    const maleTotal = Number(attend.totalMale) || 0;
    const femaleTotal = Number(attend.totalFemale) || 0;
    const totalStudent = Number(attend.totalStudent) || 0;

    const maleAttend = Number(attend.male) || 0;
    const femaleAttend = Number(attend.female) || 0;
    const totalAttend = Number(attend.total) || 0;

    const maleAbsent = Math.max(0, maleTotal - maleAttend);
    const femaleAbsent = Math.max(0, femaleTotal - femaleAttend);
    const totalAbsent = Math.max(0, totalStudent - totalAttend);

    return {
      grade: cls.grade,
      maleTotal,
      femaleTotal,
      totalStudent,
      maleAttend,
      femaleAttend,
      totalAttend,
      maleAbsent,
      femaleAbsent,
      totalAbsent,
      teacher: cls.teacher || "",
      isSummary: false
    };
  });

  const reportRows = buildReportRowsWithSummary_(detailRows);

  const summary = createEmptyReportSummary_("รวมนักเรียนทั้งหมด");
  detailRows.forEach(row => addReportRowToSummary_(summary, row));

  const percent = summary.totalStudent > 0
    ? ((summary.totalAttend / summary.totalStudent) * 100).toFixed(2)
    : "0.00";

  const reportValues = reportRows.map(row => [
    row.grade,
    row.maleTotal,
    row.femaleTotal,
    row.totalStudent,
    row.maleAttend,
    row.femaleAttend,
    row.totalAttend,
