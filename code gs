  // A วันที่ | B ระดับชั้น | C ชายทั้งหมด | D หญิงทั้งหมด | E รวมทั้งหมด | F ชายมา | G หญิงมา | H รวมมา
  sh.getRange(row, 3).setValue(maleTotal);
  sh.getRange(row, 4).setValue(femaleTotal);
  sh.getRange(row, 5).setValue(totalStudent);
  sh.getRange(row, 6).setValue(maleCome);
  sh.getRange(row, 7).setValue(femaleCome);
  sh.getRange(row, 8).setValue(totalCome);

  return {
    success: true,
    message: "แก้ไขข้อมูลเรียบร้อยแล้ว"
  };
