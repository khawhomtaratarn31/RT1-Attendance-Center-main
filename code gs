function buildReportRowsWithSummary_(classRows) {
  const result = [];

  const groups = {
    "อนุบาล": {},
    "ประถม": {},
    "มัธยม": {}
  };

  classRows.forEach(row => {
    const group = getClassGroup_(row.grade);
    const level = extractLevelNumber_(row.grade);

    if (!groups[group][level]) {
      groups[group][level] = [];
    }

    groups[group][level].push(row);
  });

  ["อนุบาล", "ประถม", "มัธยม"].forEach(group => {
    let groupSum = createEmptyReportSummary_(getGroupSummaryName_(group));

    const levels = Object.keys(groups[group])
      .map(Number)
      .sort((a, b) => a - b);

    levels.forEach(level => {
      let levelSum = createEmptyReportSummary_(getLevelSummaryName_(group, level));

      groups[group][level].forEach(row => {
        result.push(row);
        addReportRowToSummary_(levelSum, row);
        addReportRowToSummary_(groupSum, row);
      });

      result.push(levelSum);
    });

    if (levels.length > 0) {
      result.push(groupSum);
    }
  });

  const grandSum = createEmptyReportSummary_("รวมนักเรียนทั้งหมด");

  result
    .filter(row => !row.isSummary)
    .forEach(row => addReportRowToSummary_(grandSum, row));

  result.push(grandSum);

  return result;
}

